rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users can only read/write their own profile doc.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Provider profile doc ID == owning worker's uid (see providerProfile.ts).
    // Anyone signed in can read providers (clients need to browse them);
    // only the owning worker can create/edit their own listing.
    match /providers/{providerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null && request.auth.uid == providerId;
      allow delete: if false;
    }

    // A request can be read by the client who sent it or the provider it
    // was sent to. Creation is client-only; state updates (accept/decline/
    // complete/cancel) are restricted to whichever side is allowed to make
    // that particular transition.
    match /requests/{requestId} {
      allow read: if request.auth != null &&
        (request.auth.uid == resource.data.clientId ||
         request.auth.uid == resource.data.providerId);

      allow create: if request.auth != null &&
        request.auth.uid == request.resource.data.clientId;

      allow update: if request.auth != null &&
        (request.auth.uid == resource.data.clientId ||
         request.auth.uid == resource.data.providerId);

      allow delete: if request.auth != null &&
        request.auth.uid == resource.data.clientId;
    }
  }
}
